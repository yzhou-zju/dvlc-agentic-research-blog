digraph mission {
 graph [rankdir=TB, bgcolor="transparent", pad="0.15", nodesep="0.28", ranksep="0.38", splines=polyline, outputorder=edgesfirst];
 node [shape=box, style="rounded,filled", color="#a8bdc8", fillcolor="#f4f8fa", fontcolor="#233d4a", fontname="Noto Sans CJK SC", fontsize=12, margin="0.14,0.10"];
 edge [color="#6b8795", penwidth=1.2, arrowsize=0.65];

 discover [label="Explore unknown locations\nORDER · CUTTER · CONTROL · KEY · PERMIT\nPOWER · DELIVERY · modules · blanks", fillcolor="#e6f0f5"];
 order [label="Read ORDER\nchoose B-AL / B-CU"];
 diagnosis [label="On-site diagnosis\nchoose M-17 / M-23 / M-41"];
 isolate [label="Confirm POWER disconnected\nverify isolation"];
 permit [label="Bring PERMIT to CONTROL\nand register in parallel", fillcolor="#fff2df", color="#d3ad75"];
 access [label="Insert KEY → turn lock → open hatch"];
 module [label="Replace with matching module"];
 blank [label="Load matching blank"];
 power [label="Connect POWER"];
 gate [label="ORDER read ∧ repaired ∧ blank loaded\npower connected ∧ permit registered", fillcolor="#e4f1e9", color="#8ab49b"];
 hold [label="Robot A continuously holds authorization", fillcolor="#fff2df", color="#d3ad75"];
 start [label="Robot B starts CUTTER\nA still holds", fillcolor="#fff2df", color="#d3ad75"];
 release [label="Start confirmed → A releases"];
 inspect [label="Process → inspect KEYS; accept only if passed"];
 deliver [label="Take accepted keys → deliver to DELIVERY"];
 shutdown [label="Shut down at CONTROL"];
 unplug [label="Finally unplug POWER"];
 {rank=same; order; diagnosis; isolate; permit}
 discover -> {order diagnosis isolate permit};
 isolate -> access -> module;
 diagnosis -> module;
 order -> blank;
 module -> blank -> power;
 order -> gate; power -> gate; permit -> gate;
 gate -> hold -> start -> release -> inspect -> deliver -> shutdown -> unplug;
}
